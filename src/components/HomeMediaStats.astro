---
import {
  Newspaper,
  MessagesSquare,
  Megaphone,
  ArrowRight
} from "lucide-astro";

import { publicationStats } from "../data/publications.js";

const stats = [
  {
    value: publicationStats.media,
    label: "Publikacji medialnych",
    description: "Artykuły, reportaże, audycje i materiały informacyjne.",
    icon: Newspaper
  },
  {
    value: publicationStats.public,
    label: "Głosów publicznych i społecznych",
    description: "Wypowiedzi ekspertów, organizacji i osób publicznych.",
    icon: MessagesSquare
  },
  {
    value: publicationStats.committee,
    label: "Materiałów Komitetu",
    description: "Wywiady, nagrania, komunikaty i materiały własne.",
    icon: Megaphone
  }
];
---

<section class="media-stats-section" aria-labelledby="media-stats-title">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="eyebrow">Sprawa w przestrzeni publicznej</p>

        <h2 id="media-stats-title">
          Publikacje i głosy poparcia
        </h2>
      </div>

      <div class="section-intro">
        <p>
          Zbieramy publikacje medialne, wypowiedzi osób publicznych,
          materiały organizacji społecznych oraz komunikację Komitetu.
        </p>

        <a href="/media">
          Zobacz wszystkie publikacje
          <ArrowRight size={17} />
        </a>
      </div>
    </div>

    <div class="stats-grid">
      {
        stats.map((stat) => {
          const Icon = stat.icon;

          return (
            <article class="stat-card">
              <div class="stat-icon" aria-hidden="true">
                <Icon size={24} stroke-width={1.8} />
              </div>

              <strong>{stat.value}</strong>

              <h3>{stat.label}</h3>

              <p>{stat.description}</p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .media-stats-section {
    padding: 96px 24px;
    background: #f4f8fb;
    border-top: 1px solid #e0eaf0;
    border-bottom: 1px solid #e0eaf0;
  }

  .section-header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.7fr);
    justify-content: space-between;
    gap: 70px;
    align-items: end;
    margin-bottom: 48px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--teal-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-header h2 {
    margin: 0;
    max-width: 650px;
    color: var(--navy);
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .section-intro {
    max-width: 530px;
  }

  .section-intro p {
    margin: 0 0 20px;
    color: #566b7a;
    line-height: 1.75;
  }

  .section-intro a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--navy);
    font-size: 0.92rem;
    font-weight: 750;
    text-decoration: none;
  }

  .section-intro a:hover {
    color: var(--teal-dark);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .stat-card {
    position: relative;
    min-height: 300px;
    padding: 30px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #dce7ed;
    border-radius: 18px;
  }

  .stat-card::after {
    content: "";
    position: absolute;
    right: -45px;
    bottom: -55px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: rgba(53, 173, 165, 0.07);
  }

  .stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 42px;
    border-radius: 13px;
    background: #edf7f7;
    color: var(--teal-dark);
  }

  .stat-card strong {
    position: relative;
    z-index: 1;
    display: block;
    margin-bottom: 12px;
    color: var(--navy);
    font-size: clamp(3rem, 5vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .stat-card h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 12px;
    max-width: 260px;
    color: var(--navy);
    font-size: 1.18rem;
    line-height: 1.35;
  }

  .stat-card p {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 300px;
    color: #607381;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .section-header {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-card:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .media-stats-section {
      padding: 72px 20px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-card,
    .stat-card:last-child {
      grid-column: auto;
    }

    .stat-card {
      min-height: auto;
      padding: 26px;
    }

    .stat-icon {
      margin-bottom: 30px;
    }
  }
</style>