---
import { Mail, Globe2, Facebook, ArrowUpRight } from "lucide-astro";
---

<footer class="site-footer">
  <div class="footer-container">

    <div class="footer-brand">

      <p class="footer-label">
        Komitet rodziców i pacjentów
      </p>

      <h2>
        Komitet na rzecz Bezpiecznej
        Onkologii Dziecięcej
      </h2>

      <p class="footer-description">
        Oddolna inicjatywa rodziców dzieci leczonych onkologicznie oraz pacjentów,
        działająca na rzecz bezpiecznej i kompleksowej opieki onkologicznej dzieci.
      </p>

    </div>

    <div class="footer-contact">
      <h2>Kontakt</h2>

      <a href="mailto:bezpiecznaonkologiadziecieca@gmail.com">
        <Mail size={18} />
        <span>bezpiecznaonkologiadziecieca@gmail.com</span>
      </a>

      <a href="/">
        <Globe2 size={18} />
        <span>bezpiecznaonkologiadziecieca.pl</span>
      </a>

      <a
        href="https://www.facebook.com/share/17k3LtTLMU/?mibextid=wwXIfr"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Facebook size={18} />
        <span>Facebook</span>
        <ArrowUpRight size={14} />
      </a>
    </div>

    <div class="footer-links">
      <h2>Na skróty</h2>

      <a href="/#aktualnosci">Aktualności</a>
      <a href="/#dokumenty">Dokumenty</a>
      <a href="/#kalendarium">Kalendarium</a>
      <a href="/o-nas">O nas</a>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© 2026 Komitet na rzecz Bezpiecznej Onkologii Dziecięcej</p>

    <div>
      <a href="/polityka-prywatnosci">Polityka prywatności</a>
      <a href="mailto:bezpiecznaonkologiadziecieca@gmail.com">Kontakt</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0b3768;
    color: #ffffff;
    padding: 56px 24px 22px;
  }

  .footer-container {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.9fr) minmax(150px, 0.45fr);
    gap: 64px;
    align-items: start;
  }

  .footer-brand {
    max-width: 500px;
  }

  .footer-label {
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .footer-brand h2 {
    margin: 0;
    max-width: 460px;
    color: #ffffff;
    font-size: clamp(1.55rem, 2.3vw, 2.2rem);
    line-height: 1.16;
    letter-spacing: -0.025em;
    text-transform: none;
  }

  .footer-description {
    margin: 20px 0 0;
    max-width: 500px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .footer-contact,
  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-contact h2,
  .footer-links h2 {
    margin: 0 0 20px;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .footer-contact a {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.92rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .footer-contact a span {
    overflow-wrap: anywhere;
  }

  .footer-contact svg {
    flex: 0 0 auto;
    margin-top: 2px;
  }

  .footer-links a {
    display: block;
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .footer-contact a:hover,
  .footer-links a:hover,
  .footer-bottom a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    width: min(1180px, 100%);
    margin: 44px auto 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.78rem;
  }

  .footer-bottom div {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  .footer-bottom a {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.78rem;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 46px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .site-footer {
      padding: 46px 20px 22px;
    }

    .footer-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-brand h2 {
      font-size: 1.65rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 36px;
    }
  }
</style>