---
import { Mail, Globe, Facebook } from "lucide-astro";
---

<footer class="footer">

  <div class="container">

    <div class="footer-grid">

      <div>

        <img
          src="/images/logo.svg"
          alt="Komitet"
          class="logo"
        />

        <p class="description">
          Komitet na rzecz Bezpiecznej Onkologii Dziecięcej to oddolna inicjatywa
          rodziców działających na rzecz bezpieczeństwa leczenia dzieci.
        </p>

      </div>

      <div>

        <h3>Kontakt</h3>

        <ul>

          <li>

            <Mail size={18}/>

            <a href="mailto:bezpiecznaonkologiadziecieca@gmail.com">
              bezpiecznaonkologiadziecieca@gmail.com
            </a>

          </li>

          <li>

            <Globe size={18}/>

            <a href="/">
              bezpiecznaonkologiadziecieca.pl
            </a>

          </li>

          <li>

            <Facebook size={18}/>

            <a href="#">
              Facebook
            </a>

          </li>

        </ul>

      </div>

    </div>

    <div class="bottom">

      © 2026 Komitet na rzecz Bezpiecznej Onkologii Dziecięcej

    </div>

  </div>

</footer>

<style>
.footer{

padding:80px 0 30px;

background:var(--navy);

color:white;

}

.footer-grid{

display:grid;

grid-template-columns:2fr 1fr;

gap:80px;

}

.logo{

width:220px;

margin-bottom:24px;

}

.description{

max-width:520px;

opacity:.8;

line-height:1.8;

}

.footer h3{

margin-bottom:20px;

}

.footer ul{

list-style:none;

padding:0;

margin:0;

display:flex;

flex-direction:column;

gap:18px;

}

.footer li{

display:flex;

gap:12px;

align-items:center;

}

.footer a{

color:white;

opacity:.85;

text-decoration:none;

}

.bottom{

margin-top:60px;

padding-top:25px;

border-top:1px solid rgba(255,255,255,.12);

opacity:.6;

font-size:.9rem;

}

@media(max-width:900px){

.footer-grid{

grid-template-columns:1fr;

gap:50px;

}

}
</style>