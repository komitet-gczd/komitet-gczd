---
import {
	HeartHandshake,
	Stethoscope,
	Microscope,
	BookOpen,
	Building2,
	Users
} from "lucide-astro";
---

<section class="pillars">
	<div class="container">

		<div class="section-heading">
			<p class="eyebrow">Fundament bezpiecznego leczenia</p>

			<h2>
				Bezpieczeństwo dzieci zależy od współpracy wielu osób.
			</h2>

			<p>
				Kompleksowa opieka onkologiczna to nie jeden oddział czy jedna decyzja.
				To system naczyń połączonych, w którym każdy element ma znaczenie.
			</p>
		</div>

		<div class="pillars-grid">

			<article class="pillar">
				<div class="icon">
					<HeartHandshake size={26} strokeWidth={1.8}/>
				</div>

				<h3>Rodzina</h3>

				<p>
					Rodzice i opiekunowie są nieodłączną częścią procesu leczenia i najlepiej znają potrzeby swoich dzieci.
				</p>
			</article>

			<article class="pillar">
				<div class="icon">
					<Stethoscope size={26} strokeWidth={1.8}/>
				</div>

				<h3>Personel medyczny</h3>

				<p>
					Lekarze, pielęgniarki i specjaliści tworzą bezpieczny proces diagnostyki oraz leczenia.
				</p>
			</article>

			<article class="pillar">
				<div class="icon">
					<Microscope size={26} strokeWidth={1.8}/>
				</div>

				<h3>Diagnostyka</h3>

				<p>
					Szybka i kompleksowa diagnostyka stanowi podstawę skutecznego leczenia dzieci.
				</p>
			</article>

			<article class="pillar">
				<div class="icon">
					<BookOpen size={26} strokeWidth={1.8}/>
				</div>

				<h3>Wiedza</h3>

				<p>
					Decyzje powinny opierać się na aktualnej wiedzy medycznej i doświadczeniu klinicznym.
				</p>
			</article>

			<article class="pillar">
				<div class="icon">
					<Building2 size={26} strokeWidth={1.8}/>
				</div>

				<h3>Instytucje</h3>

				<p>
					Odpowiedzialne decyzje organizacyjne mają bezpośredni wpływ na bezpieczeństwo najmłodszych pacjentów.
				</p>
			</article>

			<article class="pillar">
				<div class="icon">
					<Users size={26} strokeWidth={1.8}/>
				</div>

				<h3>Współpraca</h3>

				<p>
					Bezpieczna onkologia dziecięca wymaga współpracy rodziców, pacjentów, ekspertów i całego systemu.
				</p>
			</article>

		</div>

	</div>
</section>

<style>
.pillars{
	padding:110px 0;
	background:#fff;
}

.section-heading{
	max-width:760px;
	margin:0 auto 70px;
	text-align:center;
}

.section-heading h2{
	margin:0;
	font-size:clamp(2.2rem,4vw,3.7rem);
	line-height:1.05;
	letter-spacing:-.04em;
	color:var(--navy);
}

.section-heading p:last-child{
	margin-top:24px;
	font-size:1.12rem;
	line-height:1.8;
	color:var(--muted);
}

.pillars-grid{

	display:grid;
	grid-template-columns:repeat(3,1fr);
	gap:24px;

}

.pillar{

	padding:34px;

	border:1px solid rgba(20,55,90,.08);

	border-radius:24px;

	background:#fff;

	transition:
	transform .22s ease,
	box-shadow .22s ease,
	border-color .22s ease;

}

.pillar:hover{

	transform:translateY(-6px);

	border-color:rgba(14,155,164,.25);

	box-shadow:0 18px 50px rgba(13,45,79,.08);

}

.icon{

	width:58px;

	height:58px;

	display:flex;

	align-items:center;

	justify-content:center;

	border-radius:18px;

	background:rgba(17,160,169,.08);

	color:var(--teal-dark);

	margin-bottom:26px;

}

.pillar h3{

	margin:0 0 16px;

	font-size:1.35rem;

	color:var(--navy);

}

.pillar p{

	margin:0;

	line-height:1.7;

	color:var(--muted);

	font-size:.98rem;

}

@media(max-width:980px){

	.pillars-grid{

		grid-template-columns:repeat(2,1fr);

	}

}

@media(max-width:700px){

	.pillars{

		padding:80px 0;

	}

	.section-heading{

		margin-bottom:50px;

	}

	.pillars-grid{

		grid-template-columns:1fr;

	}

}
</style>