---
const events = [
	{
		date: "2024",
		title: "Pierwsze sygnały",
		description: "Rodzice i personel zgłaszają problemy wymagające wyjaśnienia."
	},
	{
		date: "2025",
		title: "Rozmowy i działania",
		description: "Podejmowane są kolejne próby dialogu z instytucjami."
	},
	{
		date: "01.07.2026",
		title: "Zmiana organizacji",
		description: "Oddział rozpoczyna działalność w nowej lokalizacji."
	},
	{
		date: "Lipiec 2026",
		title: "Stanowisko lekarzy",
		description: "Lekarze przedstawiają opinii publicznej istotne fakty."
	},
	{
		date: "Działamy dalej",
		title: "Wspólna reprezentacja",
		description: "Rodzice organizują działania na rzecz bezpiecznego leczenia."
	}
];
---

<section class="timeline-section section">
	<div class="container card timeline-card">
		<div class="section-heading">
			<p class="eyebrow">Najważniejsze wydarzenia</p>
			<h2>Kalendarium sprawy</h2>
		</div>

		<div class="timeline">
			{
				events.map((event, index) => (
					<article class="timeline-item">
						<div class="timeline-marker">
							<span>{index + 1}</span>
						</div>

						<strong>{event.date}</strong>
						<h3>{event.title}</h3>
						<p>{event.description}</p>
					</article>
				))
			}
		</div>

		<div class="timeline-action">
			<a class="button button-secondary" href="/kalendarium">
				Zobacz pełne kalendarium
			</a>
		</div>
	</div>
</section>

<style>
	.timeline-section {
		padding-top: 24px;
	}

	.timeline-card {
		padding: 34px;
	}

	.timeline {
		position: relative;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 28px;
	}

	.timeline::before {
		content: "";
		position: absolute;
		top: 27px;
		left: 8%;
		right: 8%;
		height: 2px;
		background: linear-gradient(90deg, var(--navy), var(--teal));
	}

	.timeline-item {
		position: relative;
		z-index: 2;
		text-align: center;
	}

	.timeline-marker {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		margin: 0 auto 17px;
		border: 2px solid var(--blue);
		border-radius: 50%;
		background: white;
	}

	.timeline-marker span {
		font-weight: 900;
		color: var(--navy);
	}

	.timeline-item strong {
		display: block;
		font-size: 0.78rem;
		color: var(--teal-dark);
	}

	.timeline-item h3 {
		margin-top: 7px;
	}

	.timeline-item p {
		margin: 8px 0 0;
		font-size: 0.82rem;
		color: var(--muted);
	}

	.timeline-action {
		margin-top: 36px;
		text-align: center;
	}

	@media (max-width: 900px) {
		.timeline {
			grid-template-columns: 1fr;
		}

		.timeline::before {
			top: 20px;
			bottom: 20px;
			left: 27px;
			right: auto;
			width: 2px;
			height: auto;
		}

		.timeline-item {
			display: grid;
			grid-template-columns: 58px 1fr;
			column-gap: 20px;
			text-align: left;
		}

		.timeline-marker {
			grid-row: 1 / 5;
		}

		.timeline-item strong,
		.timeline-item h3,
		.timeline-item p {
			grid-column: 2;
		}
	}
</style>