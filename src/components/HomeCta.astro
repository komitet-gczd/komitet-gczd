---
import { ArrowRight } from "lucide-astro";
---

<section class="cta">
  <div class="container">

    <div class="cta-box">

      <p class="eyebrow">Dołącz do nas</p>

      <h2>
        Razem możemy zadbać o bezpieczną onkologię dziecięcą.
      </h2>

      <p>
        Śledź nasze działania, zapoznaj się z dokumentami i pomóż nagłaśniać
        sprawę bezpieczeństwa leczenia najmłodszych pacjentów.
      </p>

      <div class="buttons">
        <a class="btn-primary" href="/kontakt">
          Skontaktuj się z nami
          <ArrowRight size={18} />
        </a>

        <a class="btn-secondary" href="/petycja">
          Podpisz petycję
        </a>
      </div>

    </div>

  </div>
</section>

<style>
.cta{
  padding:110px 0;
  background:#f8fafc;
}

.cta-box{

  background:linear-gradient(
    135deg,
    var(--navy),
    #1b4b7d
  );

  border-radius:32px;

  padding:80px 70px;

  color:white;

  text-align:center;

  overflow:hidden;

  position:relative;

}

.cta-box::before{

  content:"";

  position:absolute;

  width:320px;

  height:320px;

  right:-120px;

  top:-120px;

  background:rgba(255,255,255,.06);

  border-radius:50%;

}

.cta-box::after{

  content:"";

  position:absolute;

  width:220px;

  height:220px;

  left:-80px;

  bottom:-80px;

  background:rgba(255,255,255,.04);

  border-radius:50%;

}

.cta-box>*{

  position:relative;

  z-index:2;

}

.cta h2{

  color:white;

  max-width:720px;

  margin:18px auto 24px;

  font-size:clamp(2.2rem,4vw,3.6rem);

  line-height:1.1;

}

.cta p:last-of-type{

  max-width:720px;

  margin:0 auto;

  opacity:.9;

  line-height:1.8;

}

.buttons{

  margin-top:42px;

  display:flex;

  justify-content:center;

  gap:18px;

  flex-wrap:wrap;

}

.btn-primary{

  display:inline-flex;

  align-items:center;

  gap:10px;

  background:white;

  color:var(--navy);

  padding:15px 26px;

  border-radius:999px;

  text-decoration:none;

  font-weight:700;

}

.btn-secondary{

  display:inline-flex;

  align-items:center;

  padding:15px 26px;

  border-radius:999px;

  border:1px solid rgba(255,255,255,.35);

  color:white;

  text-decoration:none;

  font-weight:600;

  transition:.2s;

}

.btn-secondary:hover{

  background:rgba(255,255,255,.08);

}

@media(max-width:768px){

.cta{

padding:80px 0;

}

.cta-box{

padding:50px 30px;

}

}
</style>