---
import { ArrowRight } from "lucide-astro";
---

<section class="cta">
  <div class="container">
    <div class="cta-box">
      <div class="cta-content">
        <p class="eyebrow">Kontakt</p>

        <h2>Masz pytania lub ważne informacje?</h2>

        <p>
          Napisz do nas. Jesteśmy rodzicami i pacjentami, którzy działają
          na rzecz bezpiecznej, kompleksowej opieki onkologicznej dzieci.
        </p>
      </div>

      <div class="cta-actions">
        <a
          class="btn-primary"
          href="mailto:bezpiecznaonkologiadziecieca@gmail.com"
        >
          Napisz do nas
          <ArrowRight size={18} />
        </a>

        <a
          class="btn-secondary"
          href="https://www.petycjeonline.com/przywromy_leczenie_dzieci_z_guzami_mozgu_i_innymi_guzami_litymi_do_gornolskiego_centrum_zdrowia_dziecka_w_katowicach#form"
          target="_blank"
          rel="noopener noreferrer"
        >
          Podpisz petycję
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 0 0 92px;
    background: #fff;
  }

  .cta-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
    padding: 54px 58px;
    color: #fff;
    background:
      radial-gradient(
        circle at 90% 10%,
        rgba(255, 255, 255, 0.12),
        transparent 30%
      ),
      linear-gradient(135deg, var(--navy), #174c7e);
    border-radius: 28px;
    overflow: hidden;
  }

  .cta-content {
    max-width: 720px;
  }

  .cta .eyebrow {
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.72);
  }

  .cta h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .cta-content > p:last-child {
    margin: 20px 0 0;
    max-width: 650px;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.75;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 210px;
  }

  .btn-primary,
  .btn-secondary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 24px;
    border-radius: 999px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .btn-primary {
    color: var(--navy);
    background: #fff;
  }

  .btn-secondary {
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.38);
  }

  .btn-primary:hover,
  .btn-secondary:hover {
    transform: translateY(-2px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  @media (max-width: 820px) {
    .cta {
      padding-bottom: 74px;
    }

    .cta-box {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 44px 32px;
    }

    .cta-actions {
      flex-direction: row;
      flex-wrap: wrap;
      min-width: 0;
    }
  }

  @media (max-width: 560px) {
    .cta-box {
      padding: 38px 24px;
      border-radius: 22px;
    }

    .cta-actions {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
    }
  }
</style>