---
import {
  ArrowRight,
  Download,
  FileText,
  Newspaper
} from "lucide-astro";

import { publications } from "../data/publications.js";
import { homeDocuments } from "../data/documents.js";

const PETITION_URL =
  "https://www.petycjeonline.com/przywromy_leczenie_dzieci_z_guzami_mozgu_i_innymi_guzami_litymi_do_gornolskiego_centrum_zdrowia_dziecka_w_katowicach#form";

const latestNews = publications
  .filter((item) => item.category === "media")
  .filter((item) => item.href && item.title && item.dateISO)
  .sort(
    (a, b) =>
      new Date(b.dateISO).getTime() -
      new Date(a.dateISO).getTime()
  )
  .slice(0, 3);
---

<section class="resources" id="aktualnosci">
  <div class="container">
    <div class="resources-grid">

      <div class="news-column">
        <div class="section-heading">
          <p class="eyebrow">Aktualności</p>
          <h2>Co dzieje się teraz?</h2>
        </div>

        <article class="featured-news">
          <a
            href={PETITION_URL}
            class="featured-image"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src="/images/news-placeholder.jpg"
              alt="Petycja o przywrócenie leczenia dzieci w GCZD"
            />
          </a>

          <div class="featured-content">
            <time datetime="2026-07-25">
              25 lipca 2026
            </time>

            <h3>
              <a
                href={PETITION_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                Petycja o przywrócenie leczenia dzieci z guzami mózgu i innymi guzami litymi w GCZD
              </a>
            </h3>

            <p>
              Podpisz petycję o przywrócenie w Górnośląskim Centrum
              Zdrowia Dziecka w Katowicach leczenia dzieci z guzami mózgu
              i innymi guzami litymi. Każdy podpis wzmacnia głos rodziców,
              pacjentów i lekarzy walczących o bezpieczną onkologię dziecięcą.
            </p>

            <a
              href={PETITION_URL}
              class="read-more"
              target="_blank"
              rel="noopener noreferrer"
            >
              Czytaj więcej
              <ArrowRight size={18} strokeWidth={2} />
            </a>
          </div>
        </article>

        <div class="news-list">
          {
            latestNews.map((news) => (
              <article class="news-item">
                <div class:list={[
                  "news-icon",
                  news.image && "news-icon--image"
                ]}>
                  {
                    news.image ? (
                      <img
                        src={news.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Newspaper
                        size={20}
                        strokeWidth={1.8}
                      />
                    )
                  }
                </div>

                <div class="news-item-content">
                  <time datetime={news.dateISO}>
                    {news.date}
                  </time>

                  <h3>
                    <a
                      href={news.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {news.title}
                    </a>
                  </h3>

                  {
                    news.source && (
                      <p class="news-source">
                        {news.source}
                      </p>
                    )
                  }
                </div>
              </article>
            ))
          }

          <a href="/media" class="all-news">
            Zobacz wszystkie publikacje
            <ArrowRight size={18} strokeWidth={2} />
          </a>
        </div>
      </div>

      <aside class="documents-column" id="dokumenty">
        <div class="section-heading">
          <p class="eyebrow">Dokumenty</p>
          <h2>Materiały do pobrania</h2>
        </div>

        <div class="documents-list">
          {
            homeDocuments.map((document) => (
              <article class="document-card">
                <div class="document-main">
                  <div class="document-icon">
                    <FileText size={23} strokeWidth={1.8} />
                  </div>

                  <div>
                    <h3>{document.shortTitle || document.title}</h3>
                    <p>
                      {document.type} · {document.date}
                    </p>
                  </div>
                </div>

                <a
                  href={document.href}
                  class="download-button"
                  aria-label={`Pobierz: ${document.title}`}
                  download
                >
                  <Download size={19} />
                </a>
              </article>
            ))
          }
        </div>


        <a href="/dokumenty" class="all-documents">
          Zobacz wszystkie dokumenty
          <ArrowRight size={18} />
        </a>
      </aside>

    </div>
  </div>
</section>

<style>
  .resources {
    padding: 88px 0 96px;
    background: #f5f9fb;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 0.85fr);
    gap: 54px;
    align-items: start;
  }

  .section-heading {
    margin-bottom: 28px;
  }

  .section-heading .eyebrow {
    margin: 0 0 8px;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--navy);
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .featured-news {
    background: #fff;
    border: 1px solid rgba(17, 55, 87, 0.08);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(20, 55, 87, 0.07);
  }

  .featured-image {
    display: block;
    overflow: hidden;
  }

  .featured-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8.4;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .featured-image:hover img {
    transform: scale(1.015);
  }

  .featured-content {
    padding: 30px 32px 32px;
  }

  .featured-content time,
  .news-item time {
    display: block;
    margin-bottom: 9px;
    color: var(--teal-dark);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .featured-content h3 {
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 2.05rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .featured-content h3 a {
    color: var(--navy);
    text-decoration: none;
  }

  .featured-content p {
    margin: 18px 0 0;
    max-width: 760px;
    color: var(--muted);
    line-height: 1.75;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 23px;
    color: var(--teal-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .news-list {
    margin-top: 18px;
    display: grid;
    gap: 12px;
  }

  .news-item {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 16px;
    align-items: center;
    padding: 18px 20px;
    background: #fff;
    border: 1px solid rgba(17, 55, 87, 0.08);
    border-radius: 15px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .news-item:hover {
    transform: translateY(-2px);
    border-color: rgba(18, 152, 162, 0.24);
    box-shadow: 0 10px 26px rgba(20, 55, 87, 0.06);
  }

  .news-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: rgba(15, 157, 166, 0.09);
    color: var(--teal-dark);
  }
  .news-icon--image {
    overflow: hidden;
    background: #e9f1f4;
  }

  .news-icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .news-item-content {
    min-width: 0;
  }

  .news-source {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .all-news {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-top: 10px;
    color: var(--navy);
    font-size: 0.93rem;
    font-weight: 700;
    text-decoration: none;
  }

  .all-news:hover {
    color: var(--teal-dark);
  }

  .news-item h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }

  .news-item h3 a {
    color: var(--navy);
    text-decoration: none;
  }

  .documents-column {
    position: sticky;
    top: 98px;
  }

  .documents-list {
    display: grid;
    gap: 12px;
  }

  .document-card {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    padding: 19px 18px;
    background: #fff;
    border: 1px solid rgba(17, 55, 87, 0.08);
    border-radius: 15px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .document-card:hover {
    transform: translateY(-2px);
    border-color: rgba(18, 152, 162, 0.24);
    box-shadow: 0 10px 26px rgba(20, 55, 87, 0.06);
  }

  .document-main {
    display: flex;
    gap: 14px;
    align-items: center;
    min-width: 0;
  }

  .document-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    border-radius: 12px;
    background: rgba(15, 157, 166, 0.09);
    color: var(--teal-dark);
  }

  .document-card h3 {
    margin: 0;
    color: var(--navy);
    font-size: 0.98rem;
    line-height: 1.35;
  }

  .document-card p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .download-button {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    flex: 0 0 40px;
    color: var(--teal-dark);
    background: rgba(15, 157, 166, 0.07);
    border-radius: 11px;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .download-button:hover {
    color: #fff;
    background: var(--teal-dark);
  }

  .all-documents {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    color: var(--navy);
    font-size: 0.93rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .resources-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .documents-column {
      position: static;
    }
  }

  @media (max-width: 680px) {
    .resources {
      padding: 70px 0 78px;
    }

    .featured-content {
      padding: 25px 22px 27px;
    }

    .featured-image img {
      aspect-ratio: 4 / 3;
    }

    .news-item {
      grid-template-columns: 42px 1fr;
      padding: 16px;
    }

    .news-icon {
      width: 42px;
      height: 42px;
    }

    .document-card {
      padding: 16px;
    }
  }
</style>