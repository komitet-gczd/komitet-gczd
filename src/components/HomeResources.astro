---
import { ArrowRight, FileText, Download } from "lucide-astro";
---

<section class="resources">
  <div class="container">
    <div class="grid">

      <!-- AKTUALNOŚCI -->

      <section>
        <div class="section-title">
          <p class="eyebrow">Aktualności</p>
          <h2>Co dzieje się teraz?</h2>
        </div>

        <article class="featured-news">
          <img src="/images/news-placeholder.jpg" alt="" />

          <div class="content">
            <span class="date">26 lipca 2026</span>

            <h3>
              Petycja o przywrócenie leczenia dzieci z guzami litymi w GCZD
            </h3>

            <p>
              Rozpoczęliśmy zbiórkę podpisów pod petycją dotyczącą przywrócenia
              leczenia dzieci z guzami mózgu i innymi guzami litymi
              w Górnośląskim Centrum Zdrowia Dziecka.
            </p>

            <a href="#">
              Czytaj więcej
              <ArrowRight size={18} />
            </a>
          </div>
        </article>

        <div class="news-list">

          <article>
            <span>24 lipca 2026</span>
            <a href="#">
              Parlamentarzyści interweniują w sprawie onkologii dziecięcej
            </a>
          </article>

          <article>
            <span>22 lipca 2026</span>
            <a href="#">
              Opublikowano stanowiska lekarzy
            </a>
          </article>

        </div>

      </section>

      <!-- DOKUMENTY -->

      <aside>

        <div class="section-title">
          <p class="eyebrow">Dokumenty</p>
          <h2>Najważniejsze materiały</h2>
        </div>

        <div class="documents">

          <article class="document">
            <div>
              <FileText size={22}/>
              <div>
                <h3>Treść petycji</h3>
                <p>PDF</p>
              </div>
            </div>

            <a href="#">
              <Download size={18}/>
            </a>
          </article>

          <article class="document">
            <div>
              <FileText size={22}/>
              <div>
                <h3>Stanowisko lekarzy (30.06)</h3>
                <p>PDF</p>
              </div>
            </div>

            <a href="#">
              <Download size={18}/>
            </a>
          </article>

          <article class="document">
            <div>
              <FileText size={22}/>
              <div>
                <h3>Stanowisko lekarzy (06.07)</h3>
                <p>PDF</p>
              </div>
            </div>

            <a href="#">
              <Download size={18}/>
            </a>
          </article>

          <article class="document">
            <div>
              <FileText size={22}/>
              <div>
                <h3>Stanowisko lekarzy (09.07)</h3>
                <p>PDF</p>
              </div>
            </div>

            <a href="#">
              <Download size={18}/>
            </a>
          </article>

        </div>

      </aside>

    </div>
  </div>
</section>

<style>
.resources{
  padding:110px 0;
  background:#f8fafc;
}

.grid{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:64px;
}

.section-title{
  margin-bottom:32px;
}

.section-title h2{
  margin-top:8px;
  color:var(--navy);
}

.featured-news{
  background:#fff;
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 12px 40px rgba(0,0,0,.06);
}

.featured-news img{
  width:100%;
  aspect-ratio:16/9;
  object-fit:cover;
  background:#d9e7ef;
}

.featured-news .content{
  padding:32px;
}

.date{
  font-size:.9rem;
  color:var(--muted);
}

.featured-news h3{
  margin:12px 0;
}

.featured-news p{
  color:var(--muted);
  line-height:1.7;
}

.featured-news a{
  margin-top:20px;
  display:inline-flex;
  align-items:center;
  gap:8px;
  color:var(--teal-dark);
  font-weight:600;
  text-decoration:none;
}

.news-list{
  margin-top:28px;
}

.news-list article{
  padding:20px 0;
  border-bottom:1px solid #e5e7eb;
}

.news-list span{
  display:block;
  font-size:.85rem;
  color:var(--muted);
  margin-bottom:6px;
}

.news-list a{
  color:var(--navy);
  text-decoration:none;
  font-weight:600;
}

.documents{
  display:flex;
  flex-direction:column;
  gap:16px;
}

.document{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:22px;
  border-radius:18px;
  background:#fff;
  box-shadow:0 8px 25px rgba(0,0,0,.05);
}

.document > div{
  display:flex;
  gap:16px;
  align-items:center;
}

.document h3{
  margin:0;
  font-size:1rem;
}

.document p{
  margin:4px 0 0;
  color:var(--muted);
  font-size:.85rem;
}

.document a{
  color:var(--teal-dark);
}

@media(max-width:960px){

.grid{
grid-template-columns:1fr;
}

}
</style>