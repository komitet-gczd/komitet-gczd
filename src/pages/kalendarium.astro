---
import BaseLayout from "../layouts/BaseLayout.astro";

const timeline = [
  {
    date: "30 czerwca 2026",
    category: "Dokument",
    title: "Pismo lekarzy",
    description:
      "Lekarze przedstawili swoje stanowisko dotyczące organizacji leczenia dzieci onkologicznych oraz planowanych zmian w funkcjonowaniu ośrodków."
  },
  {
    date: "1 lipca 2026",
    category: "Wydarzenie",
    title: "Otwarcie ośrodka w Zabrzu",
    description:
      "Rozpoczęła działalność nowa siedziba Śląskiego Centrum Onkologii i Hematologii Dziecięcej w Zabrzu."
  },
  {
    date: "9 lipca 2026",
    category: "Dokument",
    title: "Oświadczenie lekarzy",
    description:
      "Opublikowano kolejne stanowisko lekarzy dotyczące bezpieczeństwa leczenia oraz organizacji opieki nad dziećmi."
  },
  {
    date: "17 lipca 2026",
    category: "Interwencja",
    title: "Interwencja parlamentarzystów",
    description:
      "Grupa śląskich posłów i senatorów skierowała interwencję w sprawie funkcjonowania dziecięcej onkologii i hematologii."
  },
  {
    date: "18 lipca 2026",
    category: "Komitet",
    title: "Powstanie Komitetu",
    description:
      "Powstał Komitet Rodziców i Pacjentów GCZD na rzecz Bezpiecznej Onkologii Dziecięcej."
  },
  {
    date: "25 lipca 2026",
    category: "Petycja",
    title: "Rozpoczęcie zbiórki podpisów",
    description:
      "Uruchomiono petycję internetową oraz rozpoczęto zbieranie podpisów w formie papierowej."
  }
];
---
<BaseLayout title="Kalendarium | Bezpieczna Onkologia Dziecięca">

<main>

<section class="page-hero">
<div class="container">

<p class="eyebrow">Kalendarium</p>

<h1>Historia naszej sprawy</h1>

<p class="lead">
Najważniejsze wydarzenia dotyczące zmian w organizacji leczenia dzieci
onkologicznych oraz działań Komitetu.
</p>

</div>
</section>

<section class="timeline-section">

<div class="container">

<div class="timeline">

{
timeline.map((item) => (

<article class="event">

<div class="event-date">

<p>{item.date}</p>

<span>{item.category}</span>

</div>

<div class="event-dot"></div>

<div class="event-content">

<h2>{item.title}</h2>

<p>{item.description}</p>

</div>

</article>

))
}

<article class="event future">

<div class="event-date">

<p>Dalszy ciąg...</p>

</div>

<div class="event-dot future-dot"></div>

<div class="event-content">

<h2>Historia wciąż się tworzy</h2>

<p>
Kalendarium będzie sukcesywnie uzupełniane o kolejne dokumenty,
wydarzenia i działania Komitetu.
</p>

</div>

</article>

</div>

</div>

</section>

</main>

</BaseLayout>

<style>

.page-hero{

padding:110px 24px 90px;

background:linear-gradient(135deg,#f4f9fc,#fff);

border-bottom:1px solid #dfeaf0;

}

.eyebrow{

margin:0 0 16px;

color:var(--teal-dark);

font-size:.75rem;

font-weight:800;

text-transform:uppercase;

letter-spacing:.16em;

}

.page-hero h1{

margin:0;

font-size:clamp(2.5rem,5vw,4.5rem);

color:var(--navy);

letter-spacing:-.04em;

}

.lead{

margin-top:28px;

max-width:760px;

font-size:1.15rem;

line-height:1.8;

color:#546877;

}

.timeline-section{

padding:90px 24px;

}

.timeline{

position:relative;

max-width:1000px;

margin:auto;

}

.timeline::before{

content:"";

position:absolute;

left:220px;

top:0;

bottom:0;

width:2px;

background:#d9e5ec;

}

.event{

display:grid;

grid-template-columns:190px 60px 1fr;

gap:0;

margin-bottom:56px;

align-items:start;

}

.event-date{

padding-right:26px;

text-align:right;

}

.event-date p{

margin:0 0 10px;

font-weight:700;

color:var(--navy);

}

.event-date span{

display:inline-block;

padding:6px 10px;

border-radius:20px;

background:#edf7f7;

color:var(--teal-dark);

font-size:.72rem;

font-weight:700;

text-transform:uppercase;

}

.event-dot{

width:18px;

height:18px;

border-radius:50%;

background:var(--teal);

margin:8px auto 0;

position:relative;

z-index:2;

border:4px solid white;

box-shadow:0 0 0 2px var(--teal);

}

.future-dot{

background:#d8e5eb;

box-shadow:0 0 0 2px #d8e5eb;

}

.event-content{

padding-left:28px;

}

.event-content h2{

margin:0 0 12px;

font-size:1.45rem;

color:var(--navy);

}

.event-content p{

margin:0;

line-height:1.8;

color:#556979;

}

@media(max-width:820px){

.timeline::before{

left:17px;

}

.event{

grid-template-columns:34px 1fr;

}

.event-date{

grid-column:2;

text-align:left;

padding:0 0 12px 20px;

}

.event-dot{

grid-row:1/3;

}

.event-content{

padding-left:20px;

}

}

</style>